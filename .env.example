# AWS
AWS_REGION=test region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

# DynamoDB Tables — use -test suffixed table names (vayu-wallets-test, etc.)
# for local dev and test.vayutransfer.com's Preview env; bare names for Production only.
DYNAMO_WALLETS_TABLE=
DYNAMO_TRANSFERS_TABLE=
DYNAMO_TRANSFER_FILES_TABLE=
DYNAMO_RECEIVE_REQUESTS_TABLE=
DYNAMO_TRANSACTIONS_TABLE=
DYNAMO_DOWNLOADS_TABLE=
DYNAMO_AUDIT_TABLE=
DYNAMO_USERS_TABLE=
DYNAMO_ZIP_JOBS_TABLE=
DYNAMO_PLATFORM_STATS_TABLE=

# Cloudflare R2 — VayuTransfer's own file storage (S3->R2 migration, separate
# bucket/keys from VayuStudios' R2 usage)
R2_TRANSFER_BUCKET=
R2_TRANSFER_ENDPOINT=
R2_TRANSFER_ACCESS_KEY_ID=
R2_TRANSFER_SECRET_ACCESS_KEY=

# Lambda ARN for the dedicated large-batch "Download All" zip builder
# (lambda/vayu-transfer-zip) — fully separate function from VayuStudios'
# own ZIP_LAMBDA_ARN. Batches under 1GB zip client-side and never need this.
TRANSFER_ZIP_LAMBDA_ARN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# SES
SES_FROM_EMAIL=noreply@vayutransfer.com
SES_REGION=ap-south-1

# App
NEXT_PUBLIC_APP_URL=
APP_SECRET=
DEFAULT_EXPIRY_HOURS=24

# Google OAuth (VayuTransfer NextAuth login AND VayuStudios' own Google
# Sign-In under /studio/api/auth/google — same Cloud OAuth client, just needs
# each redirect URI registered: /api/auth/callback/google (NextAuth) and
# /studio/api/auth/google/callback (VayuStudios)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Google Drive import ("Import from Google Drive" on the upload page) —
# reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above (same OAuth client,
# one more redirect URI registered: see README for exact setup steps), but
# is otherwise a fully separate consent flow from NextAuth login/signup —
# requesting only the drive.file scope (files the user explicitly picks).
GOOGLE_DRIVE_REDIRECT_URI=
# Google Picker widget's own API key — client-safe (NEXT_PUBLIC_), but
# restrict it to your domain(s) via HTTP referrer restrictions in the
# Google Cloud Console (Credentials -> this API key -> Application
# restrictions). Separate from GOOGLE_CLIENT_SECRET, which must never be
# exposed to the browser.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Your Google Cloud project NUMBER (not the project ID) — required by the
# Picker widget. Find it on the Cloud Console's project dashboard.
NEXT_PUBLIC_GOOGLE_APP_ID=
DYNAMO_DRIVE_TOKENS_TABLE=
DYNAMO_DRIVE_JOBS_TABLE=
# ARN of the lambda/vayu-drive-import Lambda (own function per environment,
# same as TRANSFER_ZIP_LAMBDA_ARN's pattern)
DRIVE_IMPORT_LAMBDA_ARN=
# Shared secret the Lambda sends back on its file-complete callback — pick
# any long random string, put the same value in the Lambda's own env if you
# ever move it off per-invoke payload passing.
GOOGLE_DRIVE_INTERNAL_SECRET=

# VayuTransfer — Platform Admin (own login, fully separate from VayuStudios'
# admin system above/below — no shared tables, cookies, or JWT secret).
# support@vayutransfer.com is a mail alias, not a real Google account, so
# this can't reuse NextAuth's Google-only sign-in — same env-only
# credentials + bcrypt-hash + JWT-cookie pattern as VayuStudios'
# PLATFORM_OWNER_EMAIL/PASSWORD below, just its own instance of it.
PLATFORM_ADMIN_EMAIL=support@vayutransfer.com
# bcrypt hash of the admin password — never store the raw password.
PLATFORM_ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# VayuStudio — Auth
STUDIO_JWT_SECRET=
STUDIO_OWNER_EMAIL=
STUDIO_OWNER_PASSWORD=
# Notified when a studio enquiry comes in, or when a studio self-onboards via Google
PLATFORM_OWNER_EMAIL=
# Production: https://studio.vayutransfer.com  |  Preview: leave blank (falls back to APP_URL/studio/home)
NEXT_PUBLIC_STUDIO_URL=

# VayuStudio — S3 + CloudFront (legacy originals storage — being migrated to R2)
STUDIO_S3_BUCKET=
STUDIO_CLOUDFRONT_DOMAIN=
STUDIO_CLOUDFRONT_KEY_PAIR_ID=
STUDIO_CLOUDFRONT_PRIVATE_KEY=

# VayuStudio — R2 originals (S3->R2 migration). Reuses STUDIO_R2_ENDPOINT
# (same Cloudflare account as the preview bucket) but has its OWN dedicated
# access key pair, deliberately separate from the preview bucket's token.
STUDIO_R2_ORIGINAL_BUCKET=
STUDIO_R2_ORIGINAL_ACCESS_KEY_ID=
STUDIO_R2_ORIGINAL_SECRET_ACCESS_KEY=

# VayuStudio — DynamoDB Tables
DYNAMO_STUDIO_STUDIOS_TABLE=
DYNAMO_STUDIO_PROJECTS_TABLE=
DYNAMO_STUDIO_MEDIAFILES_TABLE=
DYNAMO_STUDIO_SELECTIONS_TABLE=
DYNAMO_STUDIO_USERS_TABLE=
DYNAMO_STUDIO_AUDITLOG_TABLE=
DYNAMO_STUDIO_OTP_TABLE=
# VayuStudio — Billing (separate tables from VayuTransfer's own transactions table)
DYNAMO_STUDIO_TRANSACTIONS_TABLE=
DYNAMO_STUDIO_USAGE_TABLE=

# VayuStudio — Raw File Transfer (native, not an integration with VayuTransfer)
DYNAMO_STUDIO_TRANSFERS_TABLE=
# Separate from PRINT_LINK_EXPIRY_SECONDS — transfer links carry unwatermarked
# RAW originals with no login, worth tuning independently. Defaults to 604800 (7 days).
TRANSFER_LINK_EXPIRY_SECONDS=

# Billing cron (storage grace-period reminder/delete job for VayuStudios) —
# CRON_SECRET is Vercel's own convention: set this exact name and Vercel
# automatically sends it as "Authorization: Bearer <value>" on every
# scheduled invocation defined in vercel.json, no extra config needed.
CRON_SECRET=

# VayuStudio — SMS (OTP)
SNS_REGION=ap-south-1
SNS_PRODUCTION_ENABLED=false

# VayuStudio — Print portal
PRINT_LINK_EXPIRY_SECONDS=604800

# VayuStudio — AI Chatbot (AWS Bedrock)
AWS_BEDROCK_REGION=ap-south-1
# Optional: override model (default is Claude 3 Haiku)
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
